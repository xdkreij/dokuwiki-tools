{#- Index of all VMs that completed fact gathering in play 1 (vm_hosts),
    one table per LCE environment. Each VM is placed in the FIRST environment whose
    regex matches its FQDN; VMs matching none are listed under "Unclassified".
    Override the list with the dw_lce_envs variable. -#}
{%- macro v(x) -%}
{%- if x is undefined or x is none or (x | string | trim) == '' -%}-
{%- else -%}%%{{ x | string | replace('\n', ' ') | trim }}%%
{%- endif -%}
{%- endmacro -%}
{#- dokuwiki_app_owners: {<key>: {role: ..., owner: ...}}. A key applies when the FQDN
    contains it (case-insensitive); if several keys match, the longest (most specific) wins. -#}
{%- macro vm_table(hosts) -%}
^ FQDN ^ Role ^ Owner ^ Operating system ^ Kernel ^ Uptime ^ IPv4 ^ MAC ^ vCPUs ^ Memory (GiB) ^
{% for h in hosts %}
{% set f = h.ansible_facts %}
{% set own = namespace(key='', role='', owner='') %}
{% set boot = ((h.ansible_facts.uptime_seconds | int) // 86400) ~ ' days' %}
{% for k, o in (dokuwiki_app_owners | default({}, true)).items() %}
{% if (k | string | lower) in h.dw_fqdn and (k | string | length) > (own.key | length) %}
{% set own.key = k | string %}
{% set own.role = (o | default({}, true)).role | default('') %}
{% set own.owner = (o | default({}, true)).owner | default('') %}
{% endif %}
{% endfor %}
| [[it:assets:{{ dw_vm_id }}:{{ h.dw_fqdn }}|{{ h.dw_fqdn }}]] | {{ v(own.role) }} | {{ v(own.owner) }} | {{ v(f.get('distribution', '') ~ ' ' ~ f.get('distribution_version', '')) }} | {{ v(f.get('kernel')) }} | {{ v(boot) }} | {{ v(f.get('default_ipv4', {}).get('address')) }} | {{ v(f.get('default_ipv4', {}).get('macaddress')) }} | {{ v(f.get('processor_vcpus')) }} | {{ v('%.1f' | format((f.get('memtotal_mb', 0) | float) / 1024)) }} |
{% else %}
| //none// | - | - | - | - | - | - | - | - | - |
{% endfor %}
{%- endmacro -%}
{#- Marker must be at the start of the FQDN or follow '-' or '.', so e.g. 'data-01' is not 'a-' -#}
{%- set lce_envs = dw_lce_envs | default([
      {'title': 'LCE: Test',       'regex': '(^|[.-])t-'},
      {'title': 'LCE: Acceptance', 'regex': '(^|[.-])a-'},
      {'title': 'LCE: Management', 'regex': '(^|[.-])m-'},
      {'title': 'LCE: Production', 'regex': '(^|[.-])p-'},
    ]) -%}
{%- set vms = vm_hosts | map('extract', hostvars) | sort(attribute='dw_fqdn') | list -%}
{%- set ns = namespace(placed=[]) -%}
====== Live assets ======

//Generated by Ansible. Manual edits will be overwritten.// Virtual machines: {{ vms | length }}.

Last updated: {{ now(utc=false, fmt='%Y-%m-%d %H:%M CET') }}

- NOTES - \\ 
{% for r in kernel.results %}
Latest {{ r.item.label }} Kernel release available: {{ (r.resources | first).nvra }} \\
{% endfor %}

{% for env in lce_envs %}
{% set members = vms | selectattr('dw_fqdn', 'search', env.regex) | rejectattr('dw_fqdn', 'in', ns.placed) | list %}
{% set ns.placed = ns.placed + (members | map(attribute='dw_fqdn') | list) %}
===== {{ env.title }} =====

{{ vm_table(members) }}

{% endfor %}
{% set others = vms | rejectattr('dw_fqdn', 'in', ns.placed) | list %}
{% if others %}
===== Unclassified =====

{{ vm_table(others) }}
{% endif %}
