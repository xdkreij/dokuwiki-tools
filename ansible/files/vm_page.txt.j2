{#- One DokuWiki page per VM. Only stable facts are used (no uptime, free
    memory/disk or timestamps), so the file only changes when the VM changes. -#}
{%- macro v(x) -%}
{%- if x is undefined or x is none or (x | string | trim) == '' -%}-
{%- else -%}%%{{ x | string | replace('\n', ' ') | trim }}%%
{%- endif -%}
{%- endmacro -%}
{%- set h = hostvars[vm_host] -%}
{%- set f = h.ansible_facts -%}
{%- set dw_fqdn = h.dokuwiki_page_name -%}
====== {{ dw_fqdn }} ======

//Generated by Ansible from gathered facts. Manual edits will be overwritten.// Back to [[..:live|live assets]].

Last updated: {{ now(utc=false, fmt='%Y-%m-%d %H:%M CET') }}

===== System =====

^ Fact ^ Value ^
| FQDN | {{ v(dw_fqdn) }} |
| Hostname | {{ v(f.get('hostname')) }} |
| Operating system | {{ v(f.get('distribution', '') ~ ' ' ~ f.get('distribution_version', '')) }} |
| OS family | {{ v(f.get('os_family')) }} |
| Kernel | {{ v(f.get('kernel')) }} |
| Architecture | {{ v(f.get('architecture')) }} |
| Virtualization | {{ v(f.get('virtualization_type', '') ~ ' / ' ~ f.get('virtualization_role', '')) }} |
| Vendor / product | {{ v(f.get('system_vendor', '') ~ ' ' ~ f.get('product_name', '')) }} |
| vCPUs | {{ v(f.get('processor_vcpus')) }} |
| Memory (GiB) | {{ v('%.1f' | format((f.get('memtotal_mb', 0) | float) / 1024)) }} |
| Default IPv4 | {{ v(f.get('default_ipv4', {}).get('address')) }} |
| Default gateway | {{ v(f.get('default_ipv4', {}).get('gateway')) }} |
| DNS servers | {{ v(f.get('dns', {}).get('nameservers', []) | join(', ')) }} |
| SELinux | {{ v(f.get('selinux', {}).get('status', '') ~ ' ' ~ f.get('selinux', {}).get('mode', '')) }} |
| Python | {{ v(f.get('python_version')) }} |

{%- set svc_regex = '(?i)(' ~ (dokuwiki_service_patterns | default(['agent', 'httpd', 'nginx', 'splunk']) | join('|')) ~ ')' %}

===== Application services =====

^ Service ^ State ^ Enabled ^
{% for s in f.get('services', {}).values()
     | selectattr('source', 'equalto', 'systemd')
     | selectattr('name', 'search', svc_regex)
     | rejectattr('name', 'search', '@\.service$')
     | sort(attribute='name') %}
| {{ v(s.name) }} | {{ v(s.state) }} | {% if s.status == 'masked' %}**{{ v(s.status) }}**{% else %}{{ v(s.status) }}{% endif %} |
{% else %}
| //none found// | - | - |
{% endfor %}

===== Network =====

^ Interface ^ MAC ^ IPv4 ^ Netmask ^
{% for iface in f.get('interfaces', []) | sort if iface != 'lo' %}
{%   set i = f.get(iface | replace('-', '_') | replace('.', '_'), {}) %}
| {{ v(iface) }} | {{ v(i.get('macaddress')) }} | {{ v(i.get('ipv4', {}).get('address')) }} | {{ v(i.get('ipv4', {}).get('netmask')) }} |
{% endfor %}

===== Filesystems =====

^ Mount ^ Device ^ Type ^ Size (GiB) ^
{% for m in f.get('mounts', []) | sort(attribute='mount')
     if m.fstype not in ['tmpfs', 'devtmpfs', 'overlay', 'squashfs', 'proc', 'sysfs'] %}
| {{ v(m.mount) }} | {{ v(m.device) }} | {{ v(m.fstype) }} | {{ v('%.1f' | format((m.size_total | default(0) | float) / 1073741824)) }} |
{% endfor %}
